rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userIn(data, key) {
      return data.keys().hasAny([key]) &&
        data[key] is list &&
        request.auth.uid in data[key];
    }

    // Users can be read by anyone (to search for players), but only write their own profile
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Owner can update their profile, but NOT sensitive stats which are managed by the secure backend
      allow update: if request.auth != null && request.auth.uid == userId
        && (!request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['tennisBallStats', 'leatherBallStats', 'achievements', 'stars', 'rankTitle', 'unlockedTitles']));

      // Notifications Subcollection inside user document
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null; // Any authenticated user can send notifications (via backend)
        allow update, delete: if false; // No client-side updates
      }
      
      // FCM Tokens Subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Followers Subcollection
      match /followers/{followerId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == followerId; 
        // A user can add themselves to someone else's followers list
      }

      // Following Subcollection
      match /following/{followingId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
        // A user manages their own following list
      }

      // Processed matches tracking (idempotent stats - any authenticated user can write)
      match /processed_matches/{matchId} {
        allow read, write: if request.auth != null;
      }
    }

    
    // Anyone can read public matches, only creators can write
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.createdBy;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.createdBy ||
        userIn(resource.data, 'adminIds') ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['team1Name', 'team2Name'])
      );
      // Scorers should only update match state (scores, ball events via backend),
      // NOT ownership/admin fields. Use the secure backend API for scoring updates.
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.createdBy ||
        userIn(resource.data, 'adminIds')
      );

      // Viewers subcollection - each user manages their own viewer doc
      match /viewers/{viewerId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == viewerId;
      }
    }

    // Broadcasts collection
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.broadcasterId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.broadcasterId ||
        (resource.data.crew != null && request.auth.uid in resource.data.crew)
      );
      // Viewer metrics updates must be handled securely via the backend
          
      allow delete: if request.auth != null && request.auth.uid == resource.data.broadcasterId;
      
      // Viewers subcollection inside broadcast
      match /viewers/{viewerId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
      
      // Messages within broadcast live chat
      match /chat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid == resource.data.captainId ||
        userIn(resource.data, 'adminIds')
      );
    }

     // Join requests collection (for team invite link feature)
     match /joinRequests/{requestId} {
       allow read: if false; // No direct client reads - use backend API
       allow create: if request.auth != null; // Any authenticated user can create requests
       allow update, delete: if false; // No client-side updates - use backend API
     }

    // Chats collection
    match /chats/{chatId} {
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid in resource.data.participants);
      allow update, delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      
      // Allow creating new chats
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Reels are public to read, only uploaders can write
    match /reels/{reelId} {
      allow read: if resource.data == null || resource.data.isPublic == true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Tournament rules
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.organizerId;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.organizerId ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['fixtures', 'pointsTable'])
      );
      // Views updates must be handled securely via the backend
    }
  }
}
